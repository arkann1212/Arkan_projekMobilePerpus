<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Warna latar dalam kotak input (Putih) -->
    <solid android:color="@color/white" />

    <!-- Tingkat kelengkungan sudut kotak input -->
    <corners android:radius="12dp" />

    <!-- Garis pinggir (border) kotak input -->
    <stroke
        android:width="1dp"
        android:color="@color/navy" />

    <!-- Jarak antara teks ketikan dengan garis pinggir (padding) -->
    <padding
        android:bottom="12dp"
        android:left="16dp"
        android:right="16dp"
        android:top="12dp" />

</shape>